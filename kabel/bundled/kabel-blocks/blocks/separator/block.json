{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 2,
    "name": "kbl/separator",
    "title": "Separator (Kabel)",
    "category": "kabel",
    "keywords": [
        "kabel",
        "separator",
        "divider",
        "line",
        "分隔线",
        "分隔线",
        "分割线"
    ],
    "description": "Bronze hairline divider with width and alignment.",
    "supports": {
        "anchor": true,
        "customClassName": true
    },
    "attributes": {
        "anchor": {
            "type": "string",
            "source": "attribute",
            "attribute": "id",
            "selector": "*"
        },
        "width": {
            "type": "number",
            "default": 96
        },
        "align": {
            "type": "string",
            "default": "left"
        },
        "color": {
            "type": "string"
        },
        "hideD": {
            "type": "boolean"
        },
        "hideT": {
            "type": "boolean"
        },
        "hideM": {
            "type": "boolean"
        },
        "mt": {
            "type": "number"
        },
        "mb": {
            "type": "number"
        },
        "mr": {
            "type": "number"
        },
        "ml": {
            "type": "number"
        },
        "mtM": {
            "type": "number"
        },
        "mbM": {
            "type": "number"
        },
        "pt": {
            "type": "number"
        },
        "pr": {
            "type": "number"
        },
        "pb": {
            "type": "number"
        },
        "pl": {
            "type": "number"
        },
        "customClass": {
            "type": "string"
        },
        "zIndex": {
            "type": "number"
        },
        "overflow": {
            "type": "string"
        },
        "rot": {
            "type": "number"
        },
        "scale": {
            "type": "number"
        },
        "tx": {
            "type": "number"
        },
        "ty": {
            "type": "number"
        },
        "padM": {
            "type": "number"
        },
        "widthT": {
            "type": "number"
        },
        "widthM": {
            "type": "number"
        },
        "mtT": {
            "type": "number"
        },
        "mbT": {
            "type": "number"
        },
        "uid": {
            "type": "string"
        },
        "cssText": {
            "type": "string"
        }
    },
    "textdomain": "kabel-blocks",
    "editorScript": "kabel-blocks-v3",
    "style": "kabel-blocks-v3",
    "editorStyle": "kabel-blocks-v3-editor"
}

{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 2,
    "name": "kbl/card",
    "title": "Card (Kabel)",
    "category": "kabel",
    "keywords": [
        "kabel",
        "card",
        "box",
        "feature",
        "卡片",
        "内容卡",
        "卡片",
        "图文卡"
    ],
    "description": "Cover image, title, text and an optional button in one bronze-lined card.",
    "supports": {
        "anchor": true,
        "customClassName": true
    },
    "attributes": {
        "anchor": {
            "type": "string",
            "source": "attribute",
            "attribute": "id",
            "selector": "*"
        },
        "mediaId": {
            "type": "number"
        },
        "mediaURL": {
            "type": "string"
        },
        "title": {
            "type": "string",
            "source": "html",
            "selector": ".kbl3-card__title",
            "default": "Wall Color Collection"
        },
        "text": {
            "type": "string",
            "source": "html",
            "selector": ".kbl3-card__text",
            "default": "Velvet-matte finish with ultra-low VOC — rich pigment that stays true for years."
        },
        "btnLabel": {
            "type": "string",
            "source": "html",
            "selector": "a"
        },
        "btnURL": {
            "type": "string"
        },
        "btnStyle": {
            "type": "string",
            "default": "cta"
        },
        "align": {
            "type": "string"
        },
        "padding": {
            "type": "number",
            "default": 24
        },
        "bgColor": {
            "type": "string"
        },
        "textColor": {
            "type": "string"
        },
        "radius": {
            "type": "number"
        },
        "shadow": {
            "type": "string"
        },
        "shadowX": {
            "type": "number"
        },
        "shadowY": {
            "type": "number"
        },
        "shadowB": {
            "type": "number"
        },
        "shadowS": {
            "type": "number"
        },
        "shadowColor": {
            "type": "string"
        },
        "borderWidth": {
            "type": "number"
        },
        "borderColor": {
            "type": "string"
        },
        "borderStyle": {
            "type": "string"
        },
        "gFrom": {
            "type": "string"
        },
        "gTo": {
            "type": "string"
        },
        "gAngle": {
            "type": "number",
            "default": 135
        },
        "gType": {
            "type": "string"
        },
        "hoverLift": {
            "type": "boolean"
        },
        "fontSize": {
            "type": "number"
        },
        "fontSizeT": {
            "type": "number"
        },
        "fontSizeM": {
            "type": "number"
        },
        "anim": {
            "type": "string"
        },
        "animDelay": {
            "type": "number"
        },
        "hideD": {
            "type": "boolean"
        },
        "hideT": {
            "type": "boolean"
        },
        "hideM": {
            "type": "boolean"
        },
        "mt": {
            "type": "number"
        },
        "mb": {
            "type": "number"
        },
        "mr": {
            "type": "number"
        },
        "ml": {
            "type": "number"
        },
        "mtM": {
            "type": "number"
        },
        "mbM": {
            "type": "number"
        },
        "pt": {
            "type": "number"
        },
        "pr": {
            "type": "number"
        },
        "pb": {
            "type": "number"
        },
        "pl": {
            "type": "number"
        },
        "customClass": {
            "type": "string"
        },
        "zIndex": {
            "type": "number"
        },
        "overflow": {
            "type": "string"
        },
        "rot": {
            "type": "number"
        },
        "scale": {
            "type": "number"
        },
        "tx": {
            "type": "number"
        },
        "ty": {
            "type": "number"
        },
        "padM": {
            "type": "number"
        },
        "paddingT": {
            "type": "number"
        },
        "paddingM": {
            "type": "number"
        },
        "mtT": {
            "type": "number"
        },
        "mbT": {
            "type": "number"
        },
        "uid": {
            "type": "string"
        },
        "cssText": {
            "type": "string"
        }
    },
    "textdomain": "kabel-blocks",
    "editorScript": "kabel-blocks-v3",
    "style": "kabel-blocks-v3",
    "editorStyle": "kabel-blocks-v3-editor"
}

{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 2,
    "name": "kbl/team",
    "title": "Team (Kabel)",
    "category": "kabel",
    "keywords": [
        "kabel",
        "team",
        "members",
        "staff",
        "团队",
        "成员",
        "团队",
        "成员"
    ],
    "description": "Team member cards with grayscale-to-color portraits, names and roles.",
    "supports": {
        "anchor": true,
        "customClassName": true
    },
    "attributes": {
        "anchor": {
            "type": "string",
            "source": "attribute",
            "attribute": "id",
            "selector": "*"
        },
        "items": {
            "type": "array",
            "default": [
                {
                    "name": "Elena Marsh",
                    "role": "Lead Color Consultant",
                    "photoId": 0,
                    "photoURL": "",
                    "linkURL": ""
                },
                {
                    "name": "Victor Hale",
                    "role": "Coatings Engineer",
                    "photoId": 0,
                    "photoURL": "",
                    "linkURL": ""
                },
                {
                    "name": "Ines Rocha",
                    "role": "Project Manager",
                    "photoId": 0,
                    "photoURL": "",
                    "linkURL": ""
                }
            ]
        },
        "columns": {
            "type": "number",
            "default": 3
        },
        "fontSize": {
            "type": "number"
        },
        "fontSizeT": {
            "type": "number"
        },
        "fontSizeM": {
            "type": "number"
        },
        "anim": {
            "type": "string"
        },
        "animDelay": {
            "type": "number"
        },
        "hideD": {
            "type": "boolean"
        },
        "hideT": {
            "type": "boolean"
        },
        "hideM": {
            "type": "boolean"
        },
        "mt": {
            "type": "number"
        },
        "mb": {
            "type": "number"
        },
        "mr": {
            "type": "number"
        },
        "ml": {
            "type": "number"
        },
        "mtM": {
            "type": "number"
        },
        "mbM": {
            "type": "number"
        },
        "pt": {
            "type": "number"
        },
        "pr": {
            "type": "number"
        },
        "pb": {
            "type": "number"
        },
        "pl": {
            "type": "number"
        },
        "customClass": {
            "type": "string"
        },
        "zIndex": {
            "type": "number"
        },
        "overflow": {
            "type": "string"
        },
        "rot": {
            "type": "number"
        },
        "scale": {
            "type": "number"
        },
        "tx": {
            "type": "number"
        },
        "ty": {
            "type": "number"
        },
        "padM": {
            "type": "number"
        },
        "mtT": {
            "type": "number"
        },
        "mbT": {
            "type": "number"
        },
        "columnsT": {
            "type": "number"
        },
        "columnsM": {
            "type": "number"
        },
        "uid": {
            "type": "string"
        },
        "cssText": {
            "type": "string"
        }
    },
    "textdomain": "kabel-blocks",
    "editorScript": "kabel-blocks-v3",
    "style": "kabel-blocks-v3",
    "editorStyle": "kabel-blocks-v3-editor"
}

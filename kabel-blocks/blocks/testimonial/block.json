{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 2,
    "name": "kbl/testimonial",
    "title": "Testimonial (Kabel)",
    "category": "kabel",
    "keywords": [
        "kabel",
        "testimonial",
        "review",
        "quote",
        "评价",
        "客户评价",
        "客户评价",
        "评价",
        "感言"
    ],
    "description": "Customer review with bronze stars, an italic quote and an avatar line.",
    "supports": {
        "anchor": true,
        "customClassName": true
    },
    "attributes": {
        "anchor": {
            "type": "string",
            "source": "attribute",
            "attribute": "id",
            "selector": "*"
        },
        "quote": {
            "type": "string",
            "source": "html",
            "selector": ".kbl3-testi__quote",
            "default": "The matte finish is exactly what we hoped for — two years on, the walls still look freshly painted."
        },
        "name": {
            "type": "string",
            "source": "html",
            "selector": ".kbl3-testi__name",
            "default": "Daniel Whitmore"
        },
        "role": {
            "type": "string",
            "source": "html",
            "selector": ".kbl3-testi__role",
            "default": "Homeowner, Brighton"
        },
        "avatarId": {
            "type": "number"
        },
        "avatarURL": {
            "type": "string"
        },
        "rating": {
            "type": "number",
            "default": 5
        },
        "align": {
            "type": "string",
            "default": "center"
        },
        "color": {
            "type": "string"
        },
        "fontSize": {
            "type": "number"
        },
        "fontSizeT": {
            "type": "number"
        },
        "fontSizeM": {
            "type": "number"
        },
        "anim": {
            "type": "string"
        },
        "animDelay": {
            "type": "number"
        },
        "hideD": {
            "type": "boolean"
        },
        "hideT": {
            "type": "boolean"
        },
        "hideM": {
            "type": "boolean"
        },
        "mt": {
            "type": "number"
        },
        "mb": {
            "type": "number"
        },
        "mr": {
            "type": "number"
        },
        "ml": {
            "type": "number"
        },
        "mtM": {
            "type": "number"
        },
        "mbM": {
            "type": "number"
        },
        "pt": {
            "type": "number"
        },
        "pr": {
            "type": "number"
        },
        "pb": {
            "type": "number"
        },
        "pl": {
            "type": "number"
        },
        "customClass": {
            "type": "string"
        },
        "zIndex": {
            "type": "number"
        },
        "overflow": {
            "type": "string"
        },
        "rot": {
            "type": "number"
        },
        "scale": {
            "type": "number"
        },
        "tx": {
            "type": "number"
        },
        "ty": {
            "type": "number"
        },
        "padM": {
            "type": "number"
        },
        "mtT": {
            "type": "number"
        },
        "mbT": {
            "type": "number"
        },
        "uid": {
            "type": "string"
        },
        "cssText": {
            "type": "string"
        }
    },
    "textdomain": "kabel-blocks",
    "editorScript": "kabel-blocks-v3",
    "style": "kabel-blocks-v3",
    "editorStyle": "kabel-blocks-v3-editor"
}

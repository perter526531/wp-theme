{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 2,
    "name": "kbl/video",
    "title": "Video (Kabel)",
    "category": "kabel",
    "keywords": [
        "kabel",
        "video",
        "youtube",
        "vimeo",
        "视频",
        "视频",
        "播放"
    ],
    "description": "Cover image with a bronze play button — plays YouTube, Vimeo or MP4 links on click.",
    "supports": {
        "anchor": true,
        "customClassName": true
    },
    "attributes": {
        "anchor": {
            "type": "string",
            "source": "attribute",
            "attribute": "id",
            "selector": "*"
        },
        "url": {
            "type": "string"
        },
        "coverId": {
            "type": "number"
        },
        "coverURL": {
            "type": "string"
        },
        "radius": {
            "type": "number"
        },
        "shadow": {
            "type": "string"
        },
        "shadowX": {
            "type": "number"
        },
        "shadowY": {
            "type": "number"
        },
        "shadowB": {
            "type": "number"
        },
        "shadowS": {
            "type": "number"
        },
        "shadowColor": {
            "type": "string"
        },
        "anim": {
            "type": "string"
        },
        "animDelay": {
            "type": "number"
        },
        "hideD": {
            "type": "boolean"
        },
        "hideT": {
            "type": "boolean"
        },
        "hideM": {
            "type": "boolean"
        },
        "mt": {
            "type": "number"
        },
        "mb": {
            "type": "number"
        },
        "mr": {
            "type": "number"
        },
        "ml": {
            "type": "number"
        },
        "mtM": {
            "type": "number"
        },
        "mbM": {
            "type": "number"
        },
        "pt": {
            "type": "number"
        },
        "pr": {
            "type": "number"
        },
        "pb": {
            "type": "number"
        },
        "pl": {
            "type": "number"
        },
        "customClass": {
            "type": "string"
        },
        "zIndex": {
            "type": "number"
        },
        "overflow": {
            "type": "string"
        },
        "rot": {
            "type": "number"
        },
        "scale": {
            "type": "number"
        },
        "tx": {
            "type": "number"
        },
        "ty": {
            "type": "number"
        },
        "padM": {
            "type": "number"
        },
        "width": {
            "type": "number"
        },
        "widthT": {
            "type": "number"
        },
        "widthM": {
            "type": "number"
        },
        "mtT": {
            "type": "number"
        },
        "mbT": {
            "type": "number"
        },
        "uid": {
            "type": "string"
        },
        "cssText": {
            "type": "string"
        }
    },
    "textdomain": "kabel-blocks",
    "editorScript": "kabel-blocks-v3",
    "style": "kabel-blocks-v3",
    "editorStyle": "kabel-blocks-v3-editor"
}

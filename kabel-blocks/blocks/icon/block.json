{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 2,
    "name": "kbl/icon",
    "title": "Icon (Kabel)",
    "category": "kabel",
    "keywords": [
        "kabel",
        "icon",
        "svg",
        "图标",
        "图标",
        "小图标"
    ],
    "description": "Pick from 28 curated stroke icons — paint, plant, globe, service.",
    "supports": {
        "anchor": true,
        "customClassName": true
    },
    "attributes": {
        "anchor": {
            "type": "string",
            "source": "attribute",
            "attribute": "id",
            "selector": "*"
        },
        "name": {
            "type": "string",
            "default": "check"
        },
        "size": {
            "type": "number",
            "default": 48
        },
        "color": {
            "type": "string"
        },
        "shape": {
            "type": "string",
            "default": "none"
        },
        "shapeBg": {
            "type": "string"
        },
        "hideD": {
            "type": "boolean"
        },
        "hideT": {
            "type": "boolean"
        },
        "hideM": {
            "type": "boolean"
        },
        "mt": {
            "type": "number"
        },
        "mb": {
            "type": "number"
        },
        "mr": {
            "type": "number"
        },
        "ml": {
            "type": "number"
        },
        "mtM": {
            "type": "number"
        },
        "mbM": {
            "type": "number"
        },
        "pt": {
            "type": "number"
        },
        "pr": {
            "type": "number"
        },
        "pb": {
            "type": "number"
        },
        "pl": {
            "type": "number"
        },
        "customClass": {
            "type": "string"
        },
        "zIndex": {
            "type": "number"
        },
        "overflow": {
            "type": "string"
        },
        "rot": {
            "type": "number"
        },
        "scale": {
            "type": "number"
        },
        "tx": {
            "type": "number"
        },
        "ty": {
            "type": "number"
        },
        "padM": {
            "type": "number"
        },
        "sizeT": {
            "type": "number"
        },
        "sizeM": {
            "type": "number"
        },
        "mtT": {
            "type": "number"
        },
        "mbT": {
            "type": "number"
        },
        "uid": {
            "type": "string"
        },
        "cssText": {
            "type": "string"
        }
    },
    "textdomain": "kabel-blocks",
    "editorScript": "kabel-blocks-v3",
    "style": "kabel-blocks-v3",
    "editorStyle": "kabel-blocks-v3-editor"
}

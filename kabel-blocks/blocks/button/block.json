{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 2,
    "name": "kbl/button",
    "title": "Button (Kabel)",
    "category": "kabel",
    "keywords": [
        "kabel",
        "button",
        "cta",
        "link",
        "按钮",
        "按钮",
        "行动按钮"
    ],
    "description": "Bronze/navy/outlined call-to-action with inline-editable label.",
    "supports": {
        "anchor": true,
        "customClassName": true
    },
    "attributes": {
        "anchor": {
            "type": "string",
            "source": "attribute",
            "attribute": "id",
            "selector": "*"
        },
        "text": {
            "type": "string",
            "source": "html",
            "selector": "a"
        },
        "url": {
            "type": "string"
        },
        "newTab": {
            "type": "boolean"
        },
        "rfq": {
            "type": "boolean"
        },
        "rfqProduct": {
            "type": "string"
        },
        "variant": {
            "type": "string",
            "default": "gold"
        },
        "size": {
            "type": "string",
            "default": "m"
        },
        "radius": {
            "type": "number"
        },
        "padX": {
            "type": "number"
        },
        "padY": {
            "type": "number"
        },
        "borderWidth": {
            "type": "number"
        },
        "borderColor": {
            "type": "string"
        },
        "borderStyle": {
            "type": "string"
        },
        "align": {
            "type": "string"
        },
        "full": {
            "type": "boolean"
        },
        "bgColor": {
            "type": "string"
        },
        "textColor": {
            "type": "string"
        },
        "fontSize": {
            "type": "number"
        },
        "fontSizeT": {
            "type": "number"
        },
        "fontSizeM": {
            "type": "number"
        },
        "fontWeight": {
            "type": "number"
        },
        "hoverBg": {
            "type": "string"
        },
        "hoverText": {
            "type": "string"
        },
        "hoverLift": {
            "type": "boolean"
        },
        "hideD": {
            "type": "boolean"
        },
        "hideT": {
            "type": "boolean"
        },
        "hideM": {
            "type": "boolean"
        },
        "mt": {
            "type": "number"
        },
        "mb": {
            "type": "number"
        },
        "mr": {
            "type": "number"
        },
        "ml": {
            "type": "number"
        },
        "mtM": {
            "type": "number"
        },
        "mbM": {
            "type": "number"
        },
        "pt": {
            "type": "number"
        },
        "pr": {
            "type": "number"
        },
        "pb": {
            "type": "number"
        },
        "pl": {
            "type": "number"
        },
        "customClass": {
            "type": "string"
        },
        "zIndex": {
            "type": "number"
        },
        "overflow": {
            "type": "string"
        },
        "rot": {
            "type": "number"
        },
        "scale": {
            "type": "number"
        },
        "tx": {
            "type": "number"
        },
        "ty": {
            "type": "number"
        },
        "padM": {
            "type": "number"
        },
        "padXT": {
            "type": "number"
        },
        "padXM": {
            "type": "number"
        },
        "mtT": {
            "type": "number"
        },
        "mbT": {
            "type": "number"
        },
        "uid": {
            "type": "string"
        },
        "cssText": {
            "type": "string"
        }
    },
    "textdomain": "kabel-blocks",
    "editorScript": "kabel-blocks-v3",
    "style": "kabel-blocks-v3",
    "editorStyle": "kabel-blocks-v3-editor"
}

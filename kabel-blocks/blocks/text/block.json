{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 2,
    "name": "kbl/text",
    "title": "Text (Kabel)",
    "category": "kabel",
    "keywords": [
        "kabel",
        "text",
        "paragraph",
        "段落",
        "段落",
        "正文",
        "文本"
    ],
    "description": "Inline-editable paragraph — click and type right on the page.",
    "supports": {
        "anchor": true,
        "customClassName": true
    },
    "attributes": {
        "anchor": {
            "type": "string",
            "source": "attribute",
            "attribute": "id",
            "selector": "*"
        },
        "text": {
            "type": "string",
            "source": "html",
            "selector": "p"
        },
        "size": {
            "type": "string",
            "default": "m"
        },
        "align": {
            "type": "string"
        },
        "color": {
            "type": "string"
        },
        "lead": {
            "type": "boolean"
        },
        "contentWidth": {
            "type": "number"
        },
        "blockAlign": {
            "type": "string"
        },
        "fontSize": {
            "type": "number"
        },
        "fontSizeT": {
            "type": "number"
        },
        "fontSizeM": {
            "type": "number"
        },
        "fontWeight": {
            "type": "number"
        },
        "lineHeight": {
            "type": "number"
        },
        "letterSpacing": {
            "type": "number"
        },
        "textTransform": {
            "type": "string"
        },
        "hideD": {
            "type": "boolean"
        },
        "hideT": {
            "type": "boolean"
        },
        "hideM": {
            "type": "boolean"
        },
        "mt": {
            "type": "number"
        },
        "mb": {
            "type": "number"
        },
        "mr": {
            "type": "number"
        },
        "ml": {
            "type": "number"
        },
        "mtM": {
            "type": "number"
        },
        "mbM": {
            "type": "number"
        },
        "pt": {
            "type": "number"
        },
        "pr": {
            "type": "number"
        },
        "pb": {
            "type": "number"
        },
        "pl": {
            "type": "number"
        },
        "customClass": {
            "type": "string"
        },
        "zIndex": {
            "type": "number"
        },
        "overflow": {
            "type": "string"
        },
        "rot": {
            "type": "number"
        },
        "scale": {
            "type": "number"
        },
        "tx": {
            "type": "number"
        },
        "ty": {
            "type": "number"
        },
        "padM": {
            "type": "number"
        },
        "mtT": {
            "type": "number"
        },
        "mbT": {
            "type": "number"
        },
        "uid": {
            "type": "string"
        },
        "cssText": {
            "type": "string"
        }
    },
    "textdomain": "kabel-blocks",
    "editorScript": "kabel-blocks-v3",
    "style": "kabel-blocks-v3",
    "editorStyle": "kabel-blocks-v3-editor"
}

{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 2,
    "name": "kbl/accordion",
    "title": "FAQ item (Kabel)",
    "category": "kabel",
    "keywords": [
        "kabel",
        "accordion",
        "faq",
        "question",
        "问答",
        "手风琴",
        "问答",
        "折叠"
    ],
    "description": "Question + collapsible answer. No JS — native details/summary.",
    "supports": {
        "anchor": true,
        "customClassName": true
    },
    "attributes": {
        "anchor": {
            "type": "string",
            "source": "attribute",
            "attribute": "id",
            "selector": "*"
        },
        "q": {
            "type": "string",
            "source": "html",
            "selector": "summary"
        },
        "a": {
            "type": "string",
            "source": "html",
            "selector": ".kbl3-acc__a"
        },
        "open": {
            "type": "boolean"
        },
        "bgColor": {
            "type": "string"
        },
        "radius": {
            "type": "number"
        },
        "hideD": {
            "type": "boolean"
        },
        "hideT": {
            "type": "boolean"
        },
        "hideM": {
            "type": "boolean"
        },
        "mt": {
            "type": "number"
        },
        "mb": {
            "type": "number"
        },
        "mr": {
            "type": "number"
        },
        "ml": {
            "type": "number"
        },
        "mtM": {
            "type": "number"
        },
        "mbM": {
            "type": "number"
        },
        "pt": {
            "type": "number"
        },
        "pr": {
            "type": "number"
        },
        "pb": {
            "type": "number"
        },
        "pl": {
            "type": "number"
        },
        "customClass": {
            "type": "string"
        },
        "zIndex": {
            "type": "number"
        },
        "overflow": {
            "type": "string"
        },
        "rot": {
            "type": "number"
        },
        "scale": {
            "type": "number"
        },
        "tx": {
            "type": "number"
        },
        "ty": {
            "type": "number"
        },
        "padM": {
            "type": "number"
        },
        "mtT": {
            "type": "number"
        },
        "mbT": {
            "type": "number"
        },
        "radiusT": {
            "type": "number"
        },
        "radiusM": {
            "type": "number"
        },
        "uid": {
            "type": "string"
        },
        "cssText": {
            "type": "string"
        }
    },
    "textdomain": "kabel-blocks",
    "editorScript": "kabel-blocks-v3",
    "style": "kabel-blocks-v3",
    "editorStyle": "kabel-blocks-v3-editor"
}

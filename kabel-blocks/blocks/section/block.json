{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 2,
    "name": "kbl/section",
    "title": "Section (Kabel)",
    "category": "kabel",
    "keywords": [
        "kabel",
        "section",
        "container",
        "band",
        "zone",
        "分区",
        "横幅",
        "区块容器"
    ],
    "description": "A full-width band with dark/light tone, background image and padding. Nest anything inside.",
    "supports": {
        "anchor": true,
        "customClassName": true
    },
    "attributes": {
        "anchor": {
            "type": "string",
            "source": "attribute",
            "attribute": "id",
            "selector": "*"
        },
        "tone": {
            "type": "string",
            "default": "dark"
        },
        "pad": {
            "type": "string",
            "default": "normal"
        },
        "width": {
            "type": "string",
            "default": "normal"
        },
        "widthPx": {
            "type": "number"
        },
        "bgColor": {
            "type": "string"
        },
        "bgURL": {
            "type": "string"
        },
        "bgId": {
            "type": "number"
        },
        "overlay": {
            "type": "number",
            "default": 45
        },
        "textColor": {
            "type": "string"
        },
        "padTop": {
            "type": "number"
        },
        "padBottom": {
            "type": "number"
        },
        "minH": {
            "type": "number"
        },
        "vAlign": {
            "type": "string"
        },
        "gFrom": {
            "type": "string"
        },
        "gTo": {
            "type": "string"
        },
        "gAngle": {
            "type": "number",
            "default": 135
        },
        "gType": {
            "type": "string"
        },
        "divTop": {
            "type": "string"
        },
        "divBottom": {
            "type": "string"
        },
        "divColor": {
            "type": "string"
        },
        "anim": {
            "type": "string"
        },
        "animDelay": {
            "type": "number"
        },
        "hideD": {
            "type": "boolean"
        },
        "hideT": {
            "type": "boolean"
        },
        "hideM": {
            "type": "boolean"
        },
        "mt": {
            "type": "number"
        },
        "mb": {
            "type": "number"
        },
        "mr": {
            "type": "number"
        },
        "ml": {
            "type": "number"
        },
        "mtM": {
            "type": "number"
        },
        "mbM": {
            "type": "number"
        },
        "pt": {
            "type": "number"
        },
        "pr": {
            "type": "number"
        },
        "pb": {
            "type": "number"
        },
        "pl": {
            "type": "number"
        },
        "customClass": {
            "type": "string"
        },
        "zIndex": {
            "type": "number"
        },
        "overflow": {
            "type": "string"
        },
        "rot": {
            "type": "number"
        },
        "scale": {
            "type": "number"
        },
        "tx": {
            "type": "number"
        },
        "ty": {
            "type": "number"
        },
        "padM": {
            "type": "number"
        },
        "ptT": {
            "type": "number"
        },
        "ptM": {
            "type": "number"
        },
        "pbT": {
            "type": "number"
        },
        "pbM": {
            "type": "number"
        },
        "minHT": {
            "type": "number"
        },
        "minHM": {
            "type": "number"
        },
        "mtT": {
            "type": "number"
        },
        "mbT": {
            "type": "number"
        },
        "uid": {
            "type": "string"
        },
        "cssText": {
            "type": "string"
        }
    },
    "textdomain": "kabel-blocks",
    "editorScript": "kabel-blocks-v3",
    "style": "kabel-blocks-v3",
    "editorStyle": "kabel-blocks-v3-editor"
}

{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 2,
    "name": "kbl/column",
    "title": "Column (Kabel)",
    "category": "kabel",
    "keywords": [
        "kabel",
        "column",
        "card",
        "container",
        "列",
        "栏"
    ],
    "description": "A single column — free container with background, padding, radius and shadow.",
    "supports": {
        "anchor": true,
        "customClassName": true
    },
    "attributes": {
        "anchor": {
            "type": "string",
            "source": "attribute",
            "attribute": "id",
            "selector": "*"
        },
        "bgColor": {
            "type": "string"
        },
        "textColor": {
            "type": "string"
        },
        "bgURL": {
            "type": "string"
        },
        "bgId": {
            "type": "number"
        },
        "overlay": {
            "type": "number",
            "default": 45
        },
        "padding": {
            "type": "number"
        },
        "radius": {
            "type": "number"
        },
        "shadow": {
            "type": "string"
        },
        "shadowX": {
            "type": "number"
        },
        "shadowY": {
            "type": "number"
        },
        "shadowB": {
            "type": "number"
        },
        "shadowS": {
            "type": "number"
        },
        "shadowColor": {
            "type": "string"
        },
        "borderWidth": {
            "type": "number"
        },
        "borderColor": {
            "type": "string"
        },
        "borderStyle": {
            "type": "string"
        },
        "contentAlign": {
            "type": "string",
            "default": "left"
        },
        "width": {
            "type": "number"
        },
        "gFrom": {
            "type": "string"
        },
        "gTo": {
            "type": "string"
        },
        "gAngle": {
            "type": "number",
            "default": 135
        },
        "gType": {
            "type": "string"
        },
        "anim": {
            "type": "string"
        },
        "animDelay": {
            "type": "number"
        },
        "hideD": {
            "type": "boolean"
        },
        "hideT": {
            "type": "boolean"
        },
        "hideM": {
            "type": "boolean"
        },
        "mt": {
            "type": "number"
        },
        "mb": {
            "type": "number"
        },
        "mr": {
            "type": "number"
        },
        "ml": {
            "type": "number"
        },
        "mtM": {
            "type": "number"
        },
        "mbM": {
            "type": "number"
        },
        "pt": {
            "type": "number"
        },
        "pr": {
            "type": "number"
        },
        "pb": {
            "type": "number"
        },
        "pl": {
            "type": "number"
        },
        "customClass": {
            "type": "string"
        },
        "zIndex": {
            "type": "number"
        },
        "overflow": {
            "type": "string"
        },
        "rot": {
            "type": "number"
        },
        "scale": {
            "type": "number"
        },
        "tx": {
            "type": "number"
        },
        "ty": {
            "type": "number"
        },
        "padM": {
            "type": "number"
        },
        "uid": {
            "type": "string"
        },
        "cssText": {
            "type": "string"
        }
    },
    "textdomain": "kabel-blocks",
    "editorScript": "kabel-blocks-v3",
    "style": "kabel-blocks-v3",
    "editorStyle": "kabel-blocks-v3-editor"
}

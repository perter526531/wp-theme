{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 2,
    "name": "kbl/post-grid",
    "title": "Post grid (Kabel)",
    "category": "kabel",
    "keywords": [
        "kabel",
        "grid",
        "products",
        "posts",
        "query",
        "产品",
        "文章网格",
        "文章列表",
        "内容列表"
    ],
    "description": "Latest products, projects or posts in a card grid — updates itself.",
    "supports": {
        "anchor": true,
        "customClassName": true
    },
    "attributes": {
        "anchor": {
            "type": "string",
            "source": "attribute",
            "attribute": "id",
            "selector": "*"
        },
        "postType": {
            "type": "string",
            "default": "product"
        },
        "columns": {
            "type": "number",
            "default": 3
        },
        "columnsT": {
            "type": "number"
        },
        "columnsM": {
            "type": "number"
        },
        "count": {
            "type": "number",
            "default": 6
        },
        "showExcerpt": {
            "type": "boolean",
            "default": true
        },
        "btnLabel": {
            "type": "string",
            "default": "View All"
        },
        "btnURL": {
            "type": "string"
        },
        "hideD": {
            "type": "boolean"
        },
        "hideT": {
            "type": "boolean"
        },
        "hideM": {
            "type": "boolean"
        },
        "mt": {
            "type": "number"
        },
        "mb": {
            "type": "number"
        },
        "mr": {
            "type": "number"
        },
        "ml": {
            "type": "number"
        },
        "mtM": {
            "type": "number"
        },
        "mbM": {
            "type": "number"
        },
        "mtT": {
            "type": "number"
        },
        "mbT": {
            "type": "number"
        },
        "uid": {
            "type": "string"
        },
        "cssText": {
            "type": "string"
        },
        "pt": {
            "type": "number"
        },
        "pr": {
            "type": "number"
        },
        "pb": {
            "type": "number"
        },
        "pl": {
            "type": "number"
        },
        "customClass": {
            "type": "string"
        },
        "zIndex": {
            "type": "number"
        },
        "overflow": {
            "type": "string"
        },
        "rot": {
            "type": "number"
        },
        "scale": {
            "type": "number"
        },
        "tx": {
            "type": "number"
        },
        "ty": {
            "type": "number"
        },
        "padM": {
            "type": "number"
        }
    },
    "textdomain": "kabel-blocks",
    "editorScript": "kabel-blocks-v3",
    "style": "kabel-blocks-v3",
    "editorStyle": "kabel-blocks-v3-editor",
    "render": "file:./render.php"
}
